// ══════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════
function checkRow(label, checked) {
  return `<div class="check-row ${checked?'done':''}" onclick="this.classList.toggle('done');this.querySelector('.check-box').classList.toggle('checked');this.querySelector('.check-status').textContent=this.classList.contains('done')?'Concluído':'Pendente';">
    <div class="check-box ${checked?'checked':''}">${checked?'✓':''}</div>
    <div class="check-text">${label}</div>
    <div class="check-status ${checked?'ok':'pend'}">${checked?'Concluído':'Pendente'}</div>
  </div>`;
}

function switchTab(id, el) {
  // Get all sibling tab content (same parent)
  const sheet = document.getElementById('sheetBody');
  sheet.querySelectorAll('[id]').forEach(el2 => { if(el2.id && !el2.id.startsWith('novaD')) el2.style.display='none'; });
  document.getElementById(id).style.display = 'block';
  document.querySelectorAll('.tab-pill').forEach(e=>e.classList.remove('active'));
  el.classList.add('active');
}

function openSheet() { document.getElementById('sheetOverlay').classList.add('open'); }
function closeSheet(e) {
  if (!e || e.target===document.getElementById('sheetOverlay')) {
    document.getElementById('sheetOverlay').classList.remove('open');
  }
}

function openUserMenu() {
  document.getElementById('menuName').textContent = currentUser.nome;
  document.getElementById('menuEmail').textContent = currentUser.email;
  document.getElementById('menuGestaoItem').style.display = currentRole==='admin'?'flex':'none';
  document.getElementById('userMenuOverlay').classList.add('open');
}
function closeUserMenu(e) {
  if (!e || e.target===document.getElementById('userMenuOverlay')) {
    document.getElementById('userMenuOverlay').classList.remove('open');
  }
}

function inviteProfissional() {
  const email = document.getElementById('invEmail')?.value;
  if (!email) { showToast('Preencha o e-mail.','error'); return; }
  if (supabase && !demoMode) {
    supabase.auth.admin?.inviteUserByEmail(email).then(() => showToast('📧 Convite enviado para '+email,'success'));
  } else {
    showToast('📧 Convite enviado para '+email,'success');
  }
}

function removeProfissional(id) {
  if (confirm('Remover este profissional?')) {
    showToast('✅ Profissional removido.','success');
  }
}

function saveToast(msg) { showToast(msg||'✅ Salvo com sucesso!','success'); }

function showLoading(txt) {
  document.getElementById('loadingText').textContent = txt||'Carregando...';
  document.getElementById('loadingEl').classList.add('show');
}
function hideLoading() { document.getElementById('loadingEl').classList.remove('show'); }

function showToast(msg, type) {
  const t = document.getElementById('toastEl');
  t.textContent = msg;
  t.className = 'toast show' + (type?' '+type:'');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), 3000);
}
</script>

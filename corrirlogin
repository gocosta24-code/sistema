async function doLogin() {
  const email = document.getElementById('loginEmail').value.trim();
  const pass  = document.getElementById('loginPass').value;
  if (!email || !pass) { showLoginError('Preencha e-mail e senha.'); return; }

  // Se Supabase ainda não carregou, tenta carregar e aguarda
  if (!supabase) {
    showLoading('Conectando...');
    await new Promise((resolve) => {
      const check = setInterval(() => {
        if (supabase) { clearInterval(check); resolve(); }
      }, 200);
      setTimeout(() => { clearInterval(check); resolve(); }, 5000);
    });
    hideLoading();
  }

  // Se ainda não tem Supabase, entra em modo demo
  if (!supabase) {
    showLoginError('Sem conexão com o servidor. Use o modo demonstração abaixo.');
    return;
  }

  showLoading('Entrando...');
  try {
    const { data, error } = await supabase.auth.signInWithPassword({ email, password: pass });
    if (error) { hideLoading(); showLoginError('E-mail ou senha incorretos.'); return; }
    const { data: profile } = await supabase.from('profissionais').select('*').eq('email', email).single();
    currentUser = { email, nome: profile?.nome || email.split('@')[0], role: profile?.nivel_acesso || 'admin', modulo: profile?.modulo || 'Todos' };
    currentRole = currentUser.role;
    hideLoading();
    startApp();
  } catch(e) {
    hideLoading();
    showLoginError('Erro de conexão. Tente novamente.');
  }
}

async function doReset() {
  const email = document.getElementById('loginEmail').value.trim();
  if (!email) { showLoginError('Digite seu e-mail para redefinir a senha.'); return; }
  if (!supabase) { showToast('Configure o Supabase primeiro.', 'error'); return; }
  await supabase.auth.resetPasswordForEmail(email);
  showToast('📧 Link enviado para ' + email, 'success');
}


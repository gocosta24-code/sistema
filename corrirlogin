function openModuleSheet(mod) {
  const titles = { pelvica:'💜 Fisioterapia Pélvica', to:'🧩 T.O. Infantil', palmilhas:'👟 Palmilhas', fisio:'🦴 Fisioterapia Geral' };
  const data = { pelvica:DATA.pelvica, to:DATA.to, palmilhas:DATA.palmilhas, fisio:DATA.fisio };
  const list = data[mod];

  document.getElementById('sheetTitle').textContent = titles[mod];
  document.getElementById('sheetBody').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <span style="font-size:13px;color:var(--ink3)">${list.length} pacientes</span>
      <button class="add-btn" onclick="openNewPatientSheet('${mod}')">+ Novo</button>
    </div>
    <div class="patient-list-mod">
    ${list.map(p => renderPatientCard(p, mod)).join('')}
    </div>`;
  openSheet();
}

function renderPatientCard(p, mod) {
  const done = Object.values(p.cl).filter(Boolean).length;
  const total = Object.keys(p.cl).length;
  const pct = Math.round(done/total*100);
  const sess = p.sessoes !== undefined ? `${p.sessoes}/${p.totalSessoes} sessões` : (p.entregue ? '✓ Entregue' : 'Aguardando');

  return `<div class="patient-card" onclick="openPatientDetail('${mod}',${p.id})">
    <div class="pc-top">
      <div>
        <div class="pc-name">${p.nome}</div>
        <div class="pc-age">${p.idade} anos${p.programa?' • '+p.programa:p.diagnostico?' • '+p.diagnostico.split('+')[0].trim():''}${p.escola?' • '+p.escola:''}</div>
      </div>
      <span class="chip ${pct===100?'chip-teal':pct>50?'chip-gold':'chip-amber'}">${done}/${total} docs</span>
    </div>
    ${p.sessoes!==undefined?`
    <div>
      <div class="pc-prog-label"><span>Sessões</span><span>${sess}</span></div>
      <div class="prog-bar"><div class="prog-fill prog-teal" style="width:${Math.round(p.sessoes/p.totalSessoes*100)}%"></div></div>
    </div>`:''}
    <div class="pc-chips">
      ${Object.entries(p.cl).map(([k,v])=>`<span class="chip ${v?'chip-teal':'chip-rose'}">${v?'✓':'✗'} ${clLabel(k,mod)}</span>`).join('')}
    </div>
  </div>`;
}

function clLabel(k, mod) {
  const labels = {
    avaliacao:'Avaliação', relAval:'Rel. Aval.', orientacoes:'Orientações', alta:'Alta',
    avaliacao_to:'Avaliação', competencias:'Competências', anamnese:'Anamnese',
    escola_to:'Escola', devolutiva:'Devolutiva',
    avalInicial:'Aval. Inicial', programacao:'Programação', reav1:'Reav. M1', reav2:'Reav. M2', relFinal:'Rel. Final',
  };
  const toMap = { avaliacao:'avaliacao', competencias:'competencias', anamnese:'anamnese', escola:'escola_to', devolutiva:'devolutiva' };
  return labels[mod==='to'?(toMap[k]||k):k] || k;
}

function openPatientDetail(mod, id) {
  const data = { pelvica:DATA.pelvica, to:DATA.to, palmilhas:DATA.palmilhas, fisio:DATA.fisio };
  const p = data[mod].find(x=>x.id===id);
  const titles = { pelvica:'💜', to:'🧩', palmilhas:'👟', fisio:'🦴' };
  document.getElementById('sheetTitle').textContent = titles[mod]+' '+p.nome;

  let body = '';
  if (mod==='pelvica') body = pelvicaDetail(p);
  else if (mod==='to') body = toDetail(p);
  else if (mod==='palmilhas') body = palmilhaDetail(p);
  else if (mod==='fisio') body = fisioDetail(p);

  document.getElementById('sheetBody').innerHTML = body;
  openSheet();
}


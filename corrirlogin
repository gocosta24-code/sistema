<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Casa Oliveira — Sistema Clínico</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" defer></script>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   TOKENS & RESET
═══════════════════════════════════════ */
:root {
  --bg:        #f8f6f2;
  --surface:   #ffffff;
  --surface2:  #f2efe9;
  --border:    #e8e3da;
  --border2:   #d4cdc0;
  --ink:       #1a1714;
  --ink2:      #5c5650;
  --ink3:      #9e9890;
  --teal:      #1a6b5a;
  --teal-lt:   #e8f4f1;
  --teal-mid:  #2d9175;
  --amber:     #b85c1a;
  --amber-lt:  #fdf1e8;
  --rose:      #b81a3a;
  --rose-lt:   #fde8ee;
  --violet:    #4a1ab8;
  --violet-lt: #ede8fd;
  --sky:       #1a5cb8;
  --sky-lt:    #e8eeff;
  --gold:      #8a6a00;
  --gold-lt:   #fdf7e0;
  --radius:    16px;
  --radius-sm: 10px;
  --shadow:    0 2px 12px rgba(26,23,20,0.08);
  --shadow-lg: 0 8px 32px rgba(26,23,20,0.14);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--ink);font-size:15px;overflow-x:hidden;}
button{font-family:'Plus Jakarta Sans',sans-serif;cursor:pointer;border:none;outline:none;}
input,select,textarea{font-family:'Plus Jakarta Sans',sans-serif;outline:none;}
a{color:inherit;text-decoration:none;}

/* ═══════════════════════════════════════
   SUPABASE CONFIG BANNER
═══════════════════════════════════════ */
#configBanner{
  position:fixed;inset:0;z-index:9999;background:var(--ink);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:32px 24px;text-align:center;
}
.config-logo{font-family:'Instrument Serif',serif;font-size:36px;color:#f8f6f2;margin-bottom:8px;}
.config-sub{font-size:13px;color:var(--ink3);margin-bottom:40px;letter-spacing:.5px;}
.config-card{background:#1f1c18;border:1px solid #333;border-radius:var(--radius);padding:28px 24px;width:100%;max-width:420px;text-align:left;}
.config-title{font-size:13px;font-weight:700;color:var(--teal-mid);text-transform:uppercase;letter-spacing:1px;margin-bottom:20px;}
.config-label{font-size:12px;color:var(--ink3);margin-bottom:6px;display:block;}
.config-input{
  width:100%;padding:12px 14px;background:#2a2520;border:1px solid #444;
  border-radius:var(--radius-sm);color:#f8f6f2;font-size:13px;margin-bottom:16px;
  transition:border-color .2s;
}
.config-input:focus{border-color:var(--teal-mid);}
.config-btn{
  width:100%;padding:14px;background:var(--teal);color:#f8f6f2;border-radius:var(--radius-sm);
  font-size:15px;font-weight:700;letter-spacing:.3px;transition:background .2s;margin-top:4px;
}
.config-btn:hover{background:var(--teal-mid);}
.config-hint{margin-top:16px;font-size:11px;color:#666;line-height:1.6;text-align:center;}
.config-hint a{color:var(--teal-mid);}
.config-skip{margin-top:12px;font-size:12px;color:#555;text-align:center;cursor:pointer;text-decoration:underline;}
.config-skip:hover{color:var(--ink3);}

/* ═══════════════════════════════════════
   LOGIN
═══════════════════════════════════════ */
#loginScreen{
  display:none;min-height:100vh;
  background:linear-gradient(160deg,#1a1714 0%,#2a2218 50%,#1a1714 100%);
  align-items:center;justify-content:center;padding:24px;
}
.login-wrap{width:100%;max-width:400px;}
.login-logo{
  font-family:'Instrument Serif',serif;font-size:42px;color:#f8f6f2;
  margin-bottom:4px;text-align:center;
}
.login-tagline{font-size:12px;color:#666;text-align:center;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:48px;}
.login-card{background:rgba(248,246,242,0.04);border:1px solid rgba(248,246,242,0.08);border-radius:var(--radius);padding:32px 28px;backdrop-filter:blur(20px);}
.login-field{margin-bottom:18px;}
.login-field label{display:block;font-size:11px;font-weight:600;color:#999;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px;}
.login-field input{
  width:100%;padding:14px 16px;background:rgba(255,255,255,0.06);
  border:1px solid rgba(255,255,255,0.1);border-radius:var(--radius-sm);
  color:#f8f6f2;font-size:15px;transition:border-color .2s;
}
.login-field input:focus{border-color:var(--teal-mid);}
.login-field input::placeholder{color:#555;}
.login-btn{
  width:100%;padding:16px;background:var(--teal);color:#f8f6f2;border-radius:var(--radius-sm);
  font-size:16px;font-weight:700;letter-spacing:.3px;transition:all .2s;margin-top:8px;
}
.login-btn:hover{background:var(--teal-mid);transform:translateY(-1px);}
.login-btn:active{transform:translateY(0);}
.login-error{background:rgba(184,26,58,0.15);border:1px solid rgba(184,26,58,0.3);border-radius:8px;padding:10px 14px;font-size:13px;color:#f08;margin-bottom:16px;display:none;}
.login-forgot{text-align:center;margin-top:16px;font-size:12px;color:#555;}
.login-forgot span{color:var(--teal-mid);cursor:pointer;}
.login-demo{margin-top:24px;border-top:1px solid rgba(255,255,255,0.06);padding-top:20px;}
.login-demo-title{font-size:11px;color:#555;text-transform:uppercase;letter-spacing:.8px;text-align:center;margin-bottom:12px;}
.demo-pills{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
.demo-pill{
  padding:6px 14px;border:1px solid rgba(255,255,255,0.12);border-radius:20px;
  font-size:12px;color:#aaa;cursor:pointer;transition:all .2s;
}
.demo-pill:hover{border-color:var(--teal-mid);color:var(--teal-mid);}

/* ═══════════════════════════════════════
   APP SHELL
═══════════════════════════════════════ */
#app{display:none;min-height:100vh;padding-bottom:80px;}

/* TOP BAR */
.topbar{
  position:sticky;top:0;z-index:100;
  background:rgba(248,246,242,0.92);border-bottom:1px solid var(--border);
  padding:0 20px;height:60px;display:flex;align-items:center;justify-content:space-between;
  backdrop-filter:blur(12px);
}
.topbar-logo{font-family:'Instrument Serif',serif;font-size:22px;color:var(--ink);}
.topbar-right{display:flex;align-items:center;gap:12px;}
.topbar-role{font-size:11px;font-weight:600;color:var(--ink3);text-transform:uppercase;letter-spacing:.6px;}
.topbar-avatar{
  width:34px;height:34px;border-radius:50%;
  background:var(--teal);color:#fff;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;cursor:pointer;
}
.topbar-notif{
  position:relative;width:34px;height:34px;border-radius:50%;
  background:var(--surface2);display:flex;align-items:center;justify-content:center;
  font-size:16px;cursor:pointer;border:1px solid var(--border);
}
.notif-dot{
  position:absolute;top:6px;right:6px;width:8px;height:8px;
  background:var(--rose);border-radius:50%;border:2px solid var(--bg);
}

/* BOTTOM NAV */
.bottom-nav{
  position:fixed;bottom:0;left:0;right:0;z-index:100;
  background:rgba(248,246,242,0.96);border-top:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-around;
  padding:8px 0 max(8px,env(safe-area-inset-bottom));
  backdrop-filter:blur(16px);
}
.nav-tab{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
  padding:6px 4px;cursor:pointer;position:relative;
  color:var(--ink3);font-size:10px;font-weight:600;letter-spacing:.3px;
  transition:color .2s;
}
.nav-tab.active{color:var(--teal);}
.nav-tab-icon{font-size:20px;line-height:1;}
.nav-tab-badge{
  position:absolute;top:4px;right:20%;width:8px;height:8px;
  background:var(--rose);border-radius:50%;border:2px solid var(--bg);
}
.nav-tab-bar{
  position:absolute;top:-1px;left:50%;transform:translateX(-50%);
  width:28px;height:3px;border-radius:2px;
  background:var(--teal);display:none;
}
.nav-tab.active .nav-tab-bar{display:block;}

/* ═══════════════════════════════════════
   PAGES
═══════════════════════════════════════ */
.page{display:none;padding:20px 20px 0;animation:pageIn .25s ease;}
.page.active{display:block;}
@keyframes pageIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.page-header{margin-bottom:20px;}
.page-title{font-family:'Instrument Serif',serif;font-size:28px;color:var(--ink);line-height:1.1;}
.page-sub{font-size:13px;color:var(--ink3);margin-top:4px;}

/* ═══════════════════════════════════════
   CARDS & SURFACE
═══════════════════════════════════════ */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:14px;box-shadow:var(--shadow);}
.card-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--ink2);margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.card-title-accent{width:4px;height:16px;border-radius:2px;}

/* ═══════════════════════════════════════
   DASHBOARD
═══════════════════════════════════════ */
.greeting{margin-bottom:24px;}
.greeting-line{font-family:'Instrument Serif',serif;font-size:32px;color:var(--ink);}
.greeting-sub{font-size:13px;color:var(--ink3);margin-top:2px;}

.stats-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}
.stat-tile{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px 16px;box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.stat-tile::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;border-radius:var(--radius) var(--radius) 0 0;}
.stat-tile.teal::before{background:var(--teal);}
.stat-tile.amber::before{background:var(--amber);}
.stat-tile.violet::before{background:var(--violet);}
.stat-tile.sky::before{background:var(--sky);}
.stat-emoji{font-size:24px;margin-bottom:10px;}
.stat-num{font-family:'Instrument Serif',serif;font-size:34px;color:var(--ink);line-height:1;}
.stat-lbl{font-size:11px;color:var(--ink3);margin-top:4px;font-weight:600;letter-spacing:.3px;}
.stat-delta{font-size:11px;margin-top:6px;font-weight:600;}
.stat-delta.up{color:var(--teal);}
.stat-delta.warn{color:var(--amber);}

.alert-strip{
  background:var(--amber-lt);border:1px solid #f5d5b0;border-radius:var(--radius-sm);
  padding:14px 16px;display:flex;align-items:flex-start;gap:12px;margin-bottom:10px;
}
.alert-strip.critical{background:var(--rose-lt);border-color:#f5b0c0;}
.alert-strip-icon{font-size:20px;flex-shrink:0;}
.alert-strip-body{}
.alert-strip-title{font-size:13px;font-weight:600;color:var(--ink);}
.alert-strip-meta{font-size:11px;color:var(--ink3);margin-top:2px;}
.alert-strip-action{margin-left:auto;flex-shrink:0;}

.timeline-item{display:flex;gap:14px;padding-bottom:16px;position:relative;}
.timeline-item::before{content:'';position:absolute;left:11px;top:24px;bottom:0;width:1px;background:var(--border);}
.timeline-item:last-child::before{display:none;}
.tl-dot{width:24px;height:24px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;}
.tl-dot.done{background:var(--teal);}
.tl-dot.soon{background:var(--amber);}
.tl-dot.future{background:var(--sky);}
.tl-body{}
.tl-title{font-size:13px;font-weight:600;color:var(--ink);}
.tl-meta{font-size:11px;color:var(--ink3);margin-top:2px;}

/* ═══════════════════════════════════════
   PATIENT LIST (MODULE)
═══════════════════════════════════════ */
.module-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;}
.add-btn{
  background:var(--teal);color:#fff;border-radius:20px;
  padding:8px 18px;font-size:13px;font-weight:700;
  display:flex;align-items:center;gap:6px;transition:background .2s;
}
.add-btn:active{background:var(--teal-mid);}

.patient-card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px;margin-bottom:12px;box-shadow:var(--shadow);
  display:flex;flex-direction:column;gap:10px;cursor:pointer;
  transition:box-shadow .2s,transform .15s;active-scale:.98;
}
.patient-card:active{transform:scale(.99);box-shadow:var(--shadow-lg);}
.pc-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
.pc-name{font-size:16px;font-weight:700;color:var(--ink);}
.pc-age{font-size:12px;color:var(--ink3);margin-top:1px;}
.pc-badge{flex-shrink:0;}
.pc-prog-label{display:flex;justify-content:space-between;font-size:11px;color:var(--ink3);margin-bottom:4px;}
.prog-bar{height:5px;background:var(--surface2);border-radius:3px;overflow:hidden;}
.prog-fill{height:100%;border-radius:3px;transition:width .4s;}
.prog-teal{background:var(--teal);}
.prog-amber{background:var(--amber);}
.prog-violet{background:var(--violet);}
.pc-chips{display:flex;gap:6px;flex-wrap:wrap;}

/* ═══════════════════════════════════════
   DETAIL / MODAL (BOTTOM SHEET)
═══════════════════════════════════════ */
.sheet-overlay{
  position:fixed;inset:0;background:rgba(26,23,20,0.5);z-index:500;
  display:none;align-items:flex-end;
  backdrop-filter:blur(4px);
}
.sheet-overlay.open{display:flex;animation:overlayIn .2s ease;}
@keyframes overlayIn{from{opacity:0}to{opacity:1}}
.sheet{
  background:var(--bg);border-radius:24px 24px 0 0;width:100%;
  max-height:92vh;overflow-y:auto;padding:0 0 max(24px,env(safe-area-inset-bottom));
  animation:sheetUp .3s cubic-bezier(.32,.72,0,1);
}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.sheet-handle{width:40px;height:4px;background:var(--border2);border-radius:2px;margin:14px auto 0;}
.sheet-header{padding:20px 20px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;}
.sheet-title{font-family:'Instrument Serif',serif;font-size:26px;color:var(--ink);}
.sheet-close{
  width:32px;height:32px;border-radius:50%;background:var(--surface2);
  display:flex;align-items:center;justify-content:center;font-size:16px;
  color:var(--ink3);cursor:pointer;flex-shrink:0;margin-top:4px;
}
.sheet-body{padding:20px;}

/* TABS */
.tab-pills{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;margin-bottom:20px;scrollbar-width:none;}
.tab-pills::-webkit-scrollbar{display:none;}
.tab-pill{
  flex-shrink:0;padding:8px 16px;border-radius:20px;font-size:13px;font-weight:600;
  background:var(--surface2);color:var(--ink3);cursor:pointer;border:1px solid var(--border);
  transition:all .2s;
}
.tab-pill.active{background:var(--teal);color:#fff;border-color:var(--teal);}

/* CHECKLIST */
.check-row{
  display:flex;align-items:center;gap:12px;padding:14px 16px;
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);
  margin-bottom:8px;cursor:pointer;transition:all .15s;
}
.check-row:active{background:var(--surface2);}
.check-box{
  width:22px;height:22px;border-radius:6px;border:2px solid var(--border2);
  flex-shrink:0;display:flex;align-items:center;justify-content:center;
  font-size:12px;transition:all .2s;
}
.check-box.checked{background:var(--teal);border-color:var(--teal);color:#fff;}
.check-text{flex:1;font-size:14px;color:var(--ink);}
.check-row.done .check-text{color:var(--ink3);text-decoration:line-through;}
.check-status{font-size:11px;font-weight:600;}
.check-status.ok{color:var(--teal);}
.check-status.pend{color:var(--amber);}

/* FORM */
.form-field{margin-bottom:16px;}
.form-label{display:block;font-size:11px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.6px;margin-bottom:7px;}
.form-input,.form-select,.form-textarea{
  width:100%;padding:13px 15px;background:var(--surface);border:1px solid var(--border);
  border-radius:var(--radius-sm);color:var(--ink);font-size:15px;transition:border-color .2s;
}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--teal);}
.form-textarea{resize:vertical;min-height:80px;line-height:1.5;}
.form-2col{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-full{grid-column:1/-1;}

/* PTS BLOCKS */
.pts-block{
  border-left:3px solid var(--teal);background:var(--teal-lt);
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
  padding:14px 16px;margin-bottom:12px;
}
.pts-block.amber{border-color:var(--amber);background:var(--amber-lt);}
.pts-block.violet{border-color:var(--violet);background:var(--violet-lt);}
.pts-block-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--teal);margin-bottom:8px;}
.pts-block.amber .pts-block-title{color:var(--amber);}
.pts-block.violet .pts-block-title{color:var(--violet);}

/* SAVE BTN */
.save-btn{
  position:sticky;bottom:max(20px,env(safe-area-inset-bottom));
  width:100%;padding:16px;background:var(--teal);color:#fff;
  border-radius:var(--radius-sm);font-size:16px;font-weight:700;
  box-shadow:0 4px 24px rgba(26,107,90,0.35);transition:background .2s;
  margin-top:8px;
}
.save-btn:active{background:var(--teal-mid);}

/* ═══════════════════════════════════════
   BADGES / CHIPS
═══════════════════════════════════════ */
.chip{
  display:inline-flex;align-items:center;gap:4px;
  padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;
}
.chip-teal{background:var(--teal-lt);color:var(--teal);}
.chip-amber{background:var(--amber-lt);color:var(--amber);}
.chip-rose{background:var(--rose-lt);color:var(--rose);}
.chip-violet{background:var(--violet-lt);color:var(--violet);}
.chip-sky{background:var(--sky-lt);color:var(--sky);}
.chip-gray{background:var(--surface2);color:var(--ink3);}
.chip-gold{background:var(--gold-lt);color:var(--gold);}

/* ═══════════════════════════════════════
   PROFISSIONAIS (ADMIN)
═══════════════════════════════════════ */
.prof-card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
  padding:16px;margin-bottom:10px;display:flex;align-items:center;gap:14px;
}
.prof-avatar{
  width:44px;height:44px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;font-weight:700;color:#fff;flex-shrink:0;
}
.prof-info{flex:1;}
.prof-name{font-size:15px;font-weight:700;color:var(--ink);}
.prof-role{font-size:12px;color:var(--ink3);margin-top:2px;}
.prof-actions{display:flex;flex-direction:column;gap:6px;align-items:flex-end;}

/* INVITE FORM */
.invite-card{
  background:var(--teal-lt);border:1px solid #b0ddd5;border-radius:var(--radius);
  padding:20px;margin-bottom:16px;
}
.invite-title{font-size:14px;font-weight:700;color:var(--teal);margin-bottom:14px;display:flex;align-items:center;gap:8px;}

/* ═══════════════════════════════════════
   USER MENU SHEET
═══════════════════════════════════════ */
.menu-item{
  display:flex;align-items:center;gap:14px;padding:16px 20px;
  border-bottom:1px solid var(--border);cursor:pointer;
  font-size:15px;font-weight:500;color:var(--ink);transition:background .15s;
}
.menu-item:last-child{border-bottom:none;}
.menu-item:active{background:var(--surface2);}
.menu-item-icon{font-size:20px;width:28px;text-align:center;}
.menu-item.danger{color:var(--rose);}

/* ═══════════════════════════════════════
   LOADING / TOAST
═══════════════════════════════════════ */
.loading{
  position:fixed;inset:0;background:rgba(248,246,242,0.85);z-index:9998;
  display:none;align-items:center;justify-content:center;flex-direction:column;gap:12px;
  backdrop-filter:blur(4px);
}
.loading.show{display:flex;}
.spin{width:36px;height:36px;border:3px solid var(--border);border-top-color:var(--teal);border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-size:14px;color:var(--ink3);}

.toast{
  position:fixed;top:72px;left:50%;transform:translateX(-50%) translateY(-20px);
  background:var(--ink);color:#f8f6f2;padding:12px 20px;border-radius:30px;
